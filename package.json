{
  "name": "touhou-spellcard-battle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npm run dev --workspace @thsc/client",
    "server": "npm run start --workspace @thsc/server",
    "server:dev": "npm run dev --workspace @thsc/server",
    "build": "npm run build --workspace @thsc/client",
    "prod": "npm run build && node packages/server/src/prod.ts",
    "typecheck": "tsc -p packages/engine/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "ws": "^8.21.1"
  }
}
